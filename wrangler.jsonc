{
  "name": "english30-listening",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/audio/*", "/papers/audio/*"],
  },
  "vars": { "RELEASE": "2026.11.21.1" },
}
